{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "clip-vote.vercel.app" }],
      "destination": "https://kurisure.jp/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "clip-vote-kyamihei.vercel.app" }],
      "destination": "https://kurisure.jp/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "clip-vote-git-master-kyamihei.vercel.app" }],
      "destination": "https://kurisure.jp/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    {
      "source": "/clips/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(bot|Bot|facebookexternalhit|Twitterbot|Slackbot|TelegramBot|Discordbot|WhatsApp|LINE|Pinterest|redditbot|Applebot).*" }],
      "destination": "/api/og/clip/:id"
    },
    {
      "source": "/broadcasters/:name",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(bot|Bot|facebookexternalhit|Twitterbot|Slackbot|TelegramBot|Discordbot|WhatsApp|LINE|Pinterest|redditbot|Applebot).*" }],
      "destination": "/api/og/broadcaster/:name"
    },
    {
      "source": "/clippers/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(bot|Bot|facebookexternalhit|Twitterbot|Slackbot|TelegramBot|Discordbot|WhatsApp|LINE|Pinterest|redditbot|Applebot).*" }],
      "destination": "/api/og/clipper/:id"
    },
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
